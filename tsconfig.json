{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@apps/*": ["./apps/*"]
    }
  },
  "include": ["core", "apps", "tests", "playwright.config.ts"]
}
